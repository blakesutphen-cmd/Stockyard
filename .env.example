# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # for the dashboard/magic-link login

# ---- Google OAuth (published-production app, single user) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/auth/google/callback

# ---- Token encryption (AES-256-GCM) ----
# 32 random bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENC_KEY=

# ---- Shared secret guarding the cron-triggered routes ----
# Must match cron_config.sync_secret in Postgres. openssl rand -hex 32
SYNC_SECRET=

# ---- Passcode gate (single-user login) ----
# APP_PASSCODE is what you type at /login. AUTH_TOKEN is the random value stored
# in the session cookie — never type it, just generate it. openssl rand -hex 32
APP_PASSCODE=
AUTH_TOKEN=

# ---- Nudge digest email (optional; no-op until set) ----
RESEND_API_KEY=
NUDGE_TO=blakesutphen@gmail.com
NUDGE_FROM=nudges@yourdomain.com

# Your own address(es) also get seeded into the my_addresses table.
